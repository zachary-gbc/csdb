# IP Change Check
*/30 * * * * pi bash /home/pi/scripts/csdb/ipcheck.sh &

# Update Conf Once A Day
0 0 * * * pi php /var/www/html/other/updateconf.php &

# GitHub Update Once A Day
@reboot pi bash /home/pi/scripts/csdb/ghupdate.sh &
0 1 * * * pi bash /home/pi/scripts/csdb/ghupdate.sh &

# Reboots Once a Month
30 1 1 * * pi echo "planned reboot" > /home/pi/reboot && sudo reboot now &

# Database Backup Once a Day
5 6 * * * pi bash /home/pi/scripts/dbbackup.sh &

# Cleanup Once a Week
30 6 * * 2 pi bash /home/pi/scripts/cleanup.sh &

